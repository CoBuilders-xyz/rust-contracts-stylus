{
  "name": "openzeppelin-stylus-hardhat-examples",
  "private": true,
  "description": "Hardhat project: compile and test OpenZeppelin Stylus examples (contracts/ is a generated copy of ../examples)",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/hardhat-ensure-contracts-link.mjs",
    "prepare:hardhat": "node scripts/hardhat-ensure-contracts-link.mjs && node scripts/hardhat-prepare-examples.mjs",
    "compile": "npm run prepare:hardhat && hardhat arb:compile --stylus --host",
    "compile:ci": "npm run compile:all",
    "compile:all": "npm run prepare:hardhat && node scripts/hardhat-compile-all-examples.mjs",
    "compile:erc20": "npm run prepare:hardhat && hardhat arb:compile --stylus --host --contracts erc20-example",
    "compile:erc721": "npm run prepare:hardhat && hardhat arb:compile --stylus --host --contracts erc721-example",
    "compile:erc1155": "npm run prepare:hardhat && hardhat arb:compile --stylus --host --contracts erc1155-example",
    "deploy:erc20": "npm run prepare:hardhat && hardhat arb:deploy --host erc20-example",
    "deploy:erc721": "npm run prepare:hardhat && hardhat arb:deploy --host erc721-example",
    "deploy:erc1155": "npm run prepare:hardhat && hardhat arb:deploy --host erc1155-example",
    "test": "npm run test:all",
    "test:all": "node scripts/hardhat-run-all-tests.mjs",
    "test:erc721": "hardhat test test/openzeppelin/erc721-example.test.ts",
    "test:erc1155": "hardhat test test/openzeppelin/erc1155-example.test.ts",
    "test:erc6909": "hardhat test test/openzeppelin/erc6909-example.test.ts",
    "test:erc6909-supply": "hardhat test test/openzeppelin/erc6909-supply-example.test.ts",
    "test:basic": "hardhat test test/openzeppelin/basic-example.test.ts",
    "test:erc20": "hardhat test test/openzeppelin/erc20-example.test.ts",
    "test:ownable": "hardhat test test/openzeppelin/ownable-example.test.ts",
    "test:access-control": "hardhat test test/openzeppelin/access-control-example.test.ts"
  },
  "devDependencies": {
    "@cobuilders/hardhat-arb-compile": "^0.0.1-alpha.16",
    "@cobuilders/hardhat-arb-deploy": "^0.0.1-alpha.16",
    "@cobuilders/hardhat-arb-node": "^0.0.1-alpha.20",
    "@cobuilders/hardhat-arb-test": "^0.0.1-alpha.16",
    "@cobuilders/hardhat-arbitrum-stylus": "^0.0.1-alpha.21",
    "@nomicfoundation/hardhat-ignition": "^3.1.5",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.15",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.5",
    "@nomicfoundation/hardhat-viem": "^3.0.7",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.11",
    "@types/node": "^22.19.19",
    "hardhat": "^3.4.5",
    "typescript": "~5.8.0",
    "viem": "^2.49.2"
  }
}
